# Oxen.ai API key (https://oxen.ai/settings/profile). Server-side only, never sent to the browser.
PROVIDER_API_KEY=

# Where the browser's uploaded images/videos/audio are stored so the model can fetch them by URL.
# Seedance accepts media as URLs only, so uploads go into an Oxen repository you own.
# The repo is created on first upload (as PUBLIC, so the model provider can fetch the files).
OXEN_UPLOAD_NAMESPACE=your-oxen-username
OXEN_UPLOAD_REPO=seedance-uploads

# Author recorded on upload commits in that repo.
OXEN_COMMIT_NAME=Seedance Studio
OXEN_COMMIT_EMAIL=you@example.com

# Optional: bill/save generations to an organization namespace instead of your user.
# TARGET_NAMESPACE=

# Local server port
PORT=3210
